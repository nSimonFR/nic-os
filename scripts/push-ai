#!/usr/bin/env bash
# Push as nSimonFR-ai. Branch protection refuses an approval from the last
# pusher (not the commit author), so a branch nSimonFR pushed can never be
# approved by nSimonFR.
#
# rpi5: Agent Vault attaches nSimonFR-ai's token to every github.com request
# (hosts/rpi5/agent-vault.nix), so a plain push already is one.
# Elsewhere: send nSimonFR-ai's gh token as a header, since the credential
# helper uses gh's *active* account. The remote may look like SSH, but
# gitconfig-shared rewrites git@github.com: to HTTPS.
#
# Usage: ./scripts/push-ai [any git push arguments]
set -euo pipefail

if git config --get-urlmatch http.proxy https://github.com/ >/dev/null; then
  exec git push "$@"
fi

if ! command -v gh >/dev/null 2>&1; then
  echo "push-ai: gh is not on PATH — needed to mint the nSimonFR-ai token" >&2
  exit 1
fi

# gh's --user matches hosts.yml's key exactly, and gh stores the spelling typed
# at login (it was `nSimonfr-ai` once), so resolve it case-insensitively.
ai_account=$(gh auth status 2>&1 \
  | sed -n 's/.*account \([A-Za-z0-9._-]*\).*/\1/p' \
  | grep -ix 'nsimonfr-ai' | head -n1)

if [ -z "$ai_account" ]; then
  echo "push-ai: no nSimonFR-ai account in gh. Run: gh auth login --user nSimonFR-ai" >&2
  exit 1
fi

if ! token=$(gh auth token --user "$ai_account" 2>/dev/null) || [ -z "$token" ]; then
  echo "push-ai: gh lists '$ai_account' but minted no token for it." >&2
  echo "push-ai: re-run: gh auth login --user nSimonFR-ai" >&2
  exit 1
fi

auth=$(printf 'x-access-token:%s' "$token" | base64 -w0)
git -c http.extraheader="AUTHORIZATION: basic ${auth}" push "$@"
