diff -ruN a/app/VaultHook.php b/app/VaultHook.php
--- a/app/VaultHook.php	1970-01-01 01:00:00.000000000 +0100
+++ b/app/VaultHook.php	2026-10-24 13:06:49.729497231 +0200
@@ -0,0 +1,21 @@
+<?php
+declare(strict_types=1);
+
+namespace DPS;
+
+/** nic-os: {vault_access} comes from the Emergency Access bridge (dps-ea-bridge). */
+final class VaultHook
+{
+    public const FALLBACK = 'Your access to the password vault will follow in a separate email.';
+
+    public static function access(string $contactId): string
+    {
+        if (!defined('DPS_VAULT_HOOK')) {
+            return self::FALLBACK;
+        }
+        $out = [];
+        $rc = 1;
+        exec(escapeshellarg(DPS_VAULT_HOOK) . ' access ' . escapeshellarg($contactId) . ' 2>/dev/null', $out, $rc);
+        return $rc === 0 && $out !== [] ? implode("\n", $out) : self::FALLBACK;
+    }
+}
