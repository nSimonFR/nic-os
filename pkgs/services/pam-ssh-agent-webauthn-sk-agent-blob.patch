 const WEBAUTHN_SK_ALGO: &[u8] = b"webauthn-sk-ecdsa-sha2-nistp256@openssh.com";
+const SK_ALGO: &[u8] = b"sk-ecdsa-sha2-nistp256@openssh.com";
 
 /// Max size for individual SSH string fields (64 KB). Prevents a malicious agent
 /// response with len=0xFFFFFFFF from causing a huge allocation.
@@ -175,7 +176,26 @@ fn is_webauthn_key_blob(blob: &[u8]) -> bool {
     if blob.len() < 4 + algo_len {
         return false;
     }
-    &blob[4..4 + algo_len] == WEBAUTHN_SK_ALGO
+    let algo = &blob[4..4 + algo_len];
+    algo == WEBAUTHN_SK_ALGO || algo == SK_ALGO
+}
+
+/// Agents that serve passkeys to OpenSSH (ShellWatch's shellwatch-agent)
+/// advertise the blob under `sk-ecdsa-…`; authorized_keys holds the
+/// `webauthn-sk-ecdsa-…` form. Same fields after the type string.
+pub fn canonical_webauthn_blob(blob: &[u8]) -> Vec<u8> {
+    if blob.len() < 4 {
+        return blob.to_vec();
+    }
+    let algo_len = u32::from_be_bytes([blob[0], blob[1], blob[2], blob[3]]) as usize;
+    if blob.len() < 4 + algo_len || &blob[4..4 + algo_len] != SK_ALGO {
+        return blob.to_vec();
+    }
+    let mut out = Vec::with_capacity(blob.len() + WEBAUTHN_SK_ALGO.len() - SK_ALGO.len());
+    out.extend_from_slice(&(WEBAUTHN_SK_ALGO.len() as u32).to_be_bytes());
+    out.extend_from_slice(WEBAUTHN_SK_ALGO);
+    out.extend_from_slice(&blob[4 + algo_len..]);
+    out
 }
 
