font-family = Fira Code Nerd Font
font-size = 12

background = #000000
background-opacity = 0.85
background-blur-radius = 20

window-padding-x = 8
window-padding-y = 8
window-padding-balance = true

cursor-style = block
cursor-style-blink = false

shell-integration = zsh

# Option+Backspace arrives as a bare DEL without macos-option-as-alt, which would
# also eat the Option dead keys (é, ç). Send ESC DEL: word-delete in zsh, herdr and Claude Code.
keybind = alt+backspace=text:\x1b\x7f
